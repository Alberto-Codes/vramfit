# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Test artifacts
.coverage
coverage.xml

# Default output of vramfit plan
/recipe.json

# Scratch probes. The ruff hook checks the whole tree, so an
# untracked .py file otherwise fails a commit that never staged it.
/scratch/

# Session harness: the repository carries .claude/, so name the
# per-machine parts a contributor must not commit.
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/routines/.state/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json

# A halted `vramfit scan` writes its run log beside --out, and --out
# defaults to a relative path. A run started from the repository root
# leaves the log here (#155). The pattern carries no leading slash, so
# it also ignores the name in a subdirectory. A run log the project
# ever wants tracked needs `git add -f` or a negation.
*.runlog.jsonl
